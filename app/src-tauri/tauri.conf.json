{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diskly",
  "version": "0.2.0",
  "identifier": "io.github.seiya058904.diskly",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Diskly",
        "width": 420,
        "height": 600,
        "minWidth": 360,
        "minHeight": 460,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "seiya058904",
    "shortDescription": "See what changed on your disks since last time",
    "copyright": "Copyright (c) 2026 seiya058904. Built on Diskghost, Copyright (c) 2026 kingchenc.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
